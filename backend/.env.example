# Copia este archivo como ".env" y llena los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ⚠️ No escribas datos reales en ESTE archivo: este sí se sube a GitHub.

# Connection string de Neon (Dashboard > Connect)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# URL del frontend que puede llamar a esta API (en producción: la URL de Vercel)
FRONTEND_URL=http://localhost:5173

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Texto largo y aleatorio para firmar las sesiones. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Zona horaria de la clínica (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
ZONA_HORARIA=America/Mexico_City

PORT=3000
